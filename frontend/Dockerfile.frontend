# syntax=docker/dockerfile:1
# The website's image. Next bakes NEXT_PUBLIC_ values into the browser code when it builds, so the
# image holds the addresses it was built with. Each is a build argument with no default; build it
# with frontend/build-image.sh, which npm run deploy -- prod --site-image runs with the cloud's values
# and .github/workflows/docker-image.yml runs with stand-in values (build only).

# Stage 1: install deps
FROM node:22-alpine AS deps
WORKDIR /app

COPY clutter/package*.json ./
RUN npm ci

# Stage 2: build
FROM node:22-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

ARG NEXT_PUBLIC_API_ENDPOINT
ARG NEXT_PUBLIC_ADAPTER_API_ENDPOINT
ARG NEXT_PUBLIC_GOOGLE_CLIENT_ID
ARG NEXT_PUBLIC_CONTACT_EMAIL
RUN test -n "${NEXT_PUBLIC_API_ENDPOINT}" && test -n "${NEXT_PUBLIC_ADAPTER_API_ENDPOINT}" && test -n "${NEXT_PUBLIC_GOOGLE_CLIENT_ID}" && test -n "${NEXT_PUBLIC_CONTACT_EMAIL}" \
 || { echo "Set the build arguments NEXT_PUBLIC_API_ENDPOINT, NEXT_PUBLIC_ADAPTER_API_ENDPOINT, NEXT_PUBLIC_GOOGLE_CLIENT_ID and NEXT_PUBLIC_CONTACT_EMAIL." >&2; exit 1; }

COPY ./clutter ./
COPY --from=deps /app/node_modules ./node_modules
RUN npm run build

# Stage 3: the standalone server (next.config.ts sets output: "standalone")
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# server.js listens on HOSTNAME:PORT; 0.0.0.0 so the load balancer and docker run can reach it.
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
COPY --from=builder --chown=node:node /app/public ./public

# The image's own unprivileged user, as Next's Docker example does.
USER node
EXPOSE 3000
CMD ["node", "server.js"]
