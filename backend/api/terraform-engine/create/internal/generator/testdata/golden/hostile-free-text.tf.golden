# resources
# REST API
resource "aws_api_gateway_rest_api" "api" {
  name        = "api"
  description = "x\" }\nresource \"aws_iam_user\" \"evil\" { name = \"$${data.aws_caller_identity.me.arn}%%{ if true }y%%{ endif }"

  endpoint_configuration {
    types = ["REGIONAL"]
  }
}

# Request Validator
resource "aws_api_gateway_request_validator" "api_body_validator" {
  rest_api_id           = aws_api_gateway_rest_api.api.id
  name                  = "validate-body"
  validate_request_body = true
}

# CORS - OPTIONS preflight
resource "aws_api_gateway_method" "api_options" {
  rest_api_id   = aws_api_gateway_rest_api.api.id
  resource_id   = aws_api_gateway_rest_api.api.root_resource_id
  http_method   = "OPTIONS"
  authorization = "NONE"
}

resource "aws_api_gateway_integration" "api_options_integration" {
  rest_api_id = aws_api_gateway_rest_api.api.id
  resource_id = aws_api_gateway_rest_api.api.root_resource_id
  http_method = aws_api_gateway_method.api_options.http_method
  type        = "MOCK"

  request_templates = {
    "application/json" = "{\"statusCode\": 200}"
  }
}

resource "aws_api_gateway_method_response" "api_options_response" {
  rest_api_id = aws_api_gateway_rest_api.api.id
  resource_id = aws_api_gateway_rest_api.api.root_resource_id
  http_method = aws_api_gateway_method.api_options.http_method
  status_code = "200"

  response_models = {
    "application/json" = "Empty"
  }

  response_parameters = {
    "method.response.header.Access-Control-Allow-Headers" = true
    "method.response.header.Access-Control-Allow-Methods" = true
    "method.response.header.Access-Control-Allow-Origin"  = true
  }
}

resource "aws_api_gateway_integration_response" "api_options_integration_response" {
  rest_api_id = aws_api_gateway_rest_api.api.id
  resource_id = aws_api_gateway_rest_api.api.root_resource_id
  http_method = aws_api_gateway_method.api_options.http_method
  status_code = aws_api_gateway_method_response.api_options_response.status_code

  # The integration must exist first, or AWS answers "Invalid Response status code specified".
  depends_on = [aws_api_gateway_integration.api_options_integration]

  response_parameters = {
    "method.response.header.Access-Control-Allow-Headers" = "'Content-Type,X-Amz-Date,Authorization,X-Api-Key,X-Amz-Security-Token'"
    "method.response.header.Access-Control-Allow-Methods" = "'POST,OPTIONS'"
    "method.response.header.Access-Control-Allow-Origin"  = "'*'"
  }
}

# Deployment. AWS refuses to deploy an API with no method, so there is none without one.
resource "aws_api_gateway_deployment" "api_deployment" {
  count       = 1
  rest_api_id = aws_api_gateway_rest_api.api.id

  triggers = {
    redeployment = sha1(jsonencode(aws_api_gateway_rest_api.api.body))
  }

  depends_on = [
    aws_api_gateway_method.api_options,
    aws_api_gateway_integration.api_options_integration,
  ]

  lifecycle {
    create_before_destroy = true
  }
}

# Stage
resource "aws_api_gateway_stage" "api_stage" {
  count         = 1
  rest_api_id   = aws_api_gateway_rest_api.api.id
  deployment_id = aws_api_gateway_deployment.api_deployment[0].id
  stage_name    = "x\" }\nresource \"aws_iam_user\" \"evil\" { name = \"$${data.aws_caller_identity.me.arn}%%{ if true }y%%{ endif }"
}

# IAM Role
resource "aws_iam_role" "fn_role" {
  name = "fn-lambda-role"
  # The customer role may create, change or pass a role only under /clutter/,
  # with this boundary and tagged ManagedBy = Clutter.
  path                 = "/clutter/"
  permissions_boundary = var.permissions_boundary_arn
  assume_role_policy = jsonencode({
    "Version" : "2012-10-17",
    "Statement" : [{
      "Action" : "sts:AssumeRole",
      "Effect" : "Allow",
      "Sid" : "",
      "Principal" : {
        "Service" : "lambda.amazonaws.com"
      }
    }]
  })

  tags = {
    ManagedBy = "Clutter"
  }
}

# Lambda Function
resource "aws_lambda_function" "fn" {
  function_name = "fn"
  role          = aws_iam_role.fn_role.arn
  handler       = "x\" }\nresource \"aws_iam_user\" \"evil\" { name = \"$${data.aws_caller_identity.me.arn}%%{ if true }y%%{ endif }"
  timeout       = 3
  runtime       = "provided.al2023"
  architectures = ["arm64"]
  memory_size      = 128
  filename         = "bootstrap.zip"
  source_code_hash = fileexists("bootstrap.zip") ? filebase64sha256("bootstrap.zip") : null
  environment {
    variables = {
      V = "x\" }\nresource \"aws_iam_user\" \"evil\" { name = \"$${data.aws_caller_identity.me.arn}%%{ if true }y%%{ endif }"
    }
  }
}

resource "aws_dynamodb_table" "table" {
  name         = "table"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "x\" }\nresource \"aws_iam_user\" \"evil\" { name = \"$${data.aws_caller_identity.me.arn}%%{ if true }y%%{ endif }"

  attribute {
    name = "x\" }\nresource \"aws_iam_user\" \"evil\" { name = \"$${data.aws_caller_identity.me.arn}%%{ if true }y%%{ endif }"
    type = "S"
  }

  ttl {
    attribute_name = "x\" }\nresource \"aws_iam_user\" \"evil\" { name = \"$${data.aws_caller_identity.me.arn}%%{ if true }y%%{ endif }"
    enabled        = true
  }
}

data "aws_ssm_parameter" "vm_ami" {
  name = "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
}

resource "aws_iam_role" "vm_ssm_role" {
  name = "vm-ssm-role"
  # The customer role may create, change or pass a role only under /clutter/,
  # with this boundary and tagged ManagedBy = Clutter. The instance below keeps
  # ManagedBy = Ansible, which is what lets the Ansible runner reach it.
  path                 = "/clutter/"
  permissions_boundary = var.permissions_boundary_arn

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "ec2.amazonaws.com" }
      Action    = "sts:AssumeRole"
    }]
  })

  tags = {
    ManagedBy = "Clutter"
  }
}

resource "aws_iam_role_policy_attachment" "vm_ssm_policy" {
  role       = aws_iam_role.vm_ssm_role.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
}

resource "aws_iam_instance_profile" "vm_ssm_profile" {
  name = "vm-ssm-profile"
  path = "/clutter/"
  role = aws_iam_role.vm_ssm_role.name
}

resource "aws_instance" "vm" {
  ami                  = data.aws_ssm_parameter.vm_ami.value
  instance_type        = "t3.micro"
  iam_instance_profile = aws_iam_instance_profile.vm_ssm_profile.name
  key_name = "x\" }\nresource \"aws_iam_user\" \"evil\" { name = \"$${data.aws_caller_identity.me.arn}%%{ if true }y%%{ endif }"

  tags = {
    Name      = "vm"
    ManagedBy = "Ansible"
  }
}

# iam

# outputs
output "api_id" {
  value = aws_api_gateway_rest_api.api.id
}

output "api_root_resource_id" {
  value = aws_api_gateway_rest_api.api.root_resource_id
}

output "api_execution_arn" {
  value = aws_api_gateway_rest_api.api.execution_arn
}

output "api_invoke_url" {
  # Null when the API has no method, and so no stage.
  value = one(aws_api_gateway_stage.api_stage[*].invoke_url)
}

output "fn_function_name" {
  value = aws_lambda_function.fn.function_name
}

output "fn_arn" {
  value = aws_lambda_function.fn.arn
}

output "fn_invoke_arn" {
  value = aws_lambda_function.fn.invoke_arn
}

output "table_arn" {
  value = aws_dynamodb_table.table.arn
}

output "table_name" {
  value = aws_dynamodb_table.table.name
}

output "vm_id" {
  value = aws_instance.vm.id
}

output "vm_public_ip" {
  value = aws_instance.vm.public_ip
}
