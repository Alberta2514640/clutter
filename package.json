{
  "name": "clutter",
  "private": true,
  "description": "Entry points for the whole repo. The frontend's own packages are in frontend/clutter.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "npm --prefix frontend/clutter ci",
    "doctor": "backend/devserver/doctor.sh",
    "setup": "backend/devserver/setup.sh",
    "dev": "backend/devserver/dev.sh",
    "dev:backend": "backend/devserver/dev.sh --backend-only",
    "dev:frontend": "backend/devserver/dev.sh --frontend-only",
    "stop": "backend/devserver/stop.sh",
    "smoke": "backend/devserver/smoke.sh",
    "localstack": "backend/devserver/localstack.sh",
    "devstack": "backend/devserver/devstack.sh",
    "deploy:plan": "backend/infra/deploy.sh plan",
    "deploy": "backend/infra/deploy.sh apply",
    "generated": "backend/devserver/generated.sh",
    "seed": "python3 backend/devserver/seed-diagram.py"
  }
}
