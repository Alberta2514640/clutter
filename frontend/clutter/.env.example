# Frontend config. Git ignores the copies; Next reads them when it builds, so a build must be redone to
# point somewhere else (docs/architecture/environments.md § Credentials day).
#   Local: copy to .env.local. The values below are A2's.
#   Cloud: not needed; npm run deploy -- prod --site-image builds the image with the cloud's values.
#          A hand build with frontend/build-image.sh may read .env.production.local.

# A's API. Local: A2's front door. Cloud: the API Gateway stage's address, which npm run deploy -- prod
# prints after it applies (terraform -chdir=backend/infra output -raw api_invoke_url).
NEXT_PUBLIC_API_ENDPOINT=http://localhost:8787

# B's API. Local: B beside A2. Cloud: the site's own origin, https:// and site_domain (B answers under /v1).
NEXT_PUBLIC_ADAPTER_API_ENDPOINT=http://localhost:8790

# The Google OAuth client id the site signs in with (src/providers/GoogleAuthProvider.tsx reads it).
# Local: backend/devserver/dev.sh passes A2's id, so leave this placeholder. Cloud: the same as
# google_client_id in backend/infra/prod.tfvars.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=NUMBER-ID.apps.googleusercontent.com

# The address people write to, shown in the public pages' footer, FAQ, privacy policy and terms
# (src/components/landing/site.ts reads it). Local: this stand-in, which is not a real inbox.
# Cloud: contact_email in backend/infra/prod.tfvars. Without it the pages say no address is set.
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
