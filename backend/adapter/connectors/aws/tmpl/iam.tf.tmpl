# Wiring from the diagram's edges. Every role and resource named here is
# rendered by A's lambda, ec2, s3, dynamodb and apigateway templates.
{{- range .Functions}}

# Every function may write its own logs.
resource "aws_iam_role_policy_attachment" "{{.}}_logs" {
  role       = aws_iam_role.{{.}}_role.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
}
{{- end}}
{{- range .BucketReads}}

# The function or VM reads the bucket: list it and get objects, nothing more.
resource "aws_iam_role_policy" "{{.Addr}}" {
  name = "{{.Name}}"
  role = {{.Role}}.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect   = "Allow"
        Action   = ["s3:ListBucket"]
        Resource = aws_s3_bucket.{{.Target}}.arn
      },
      {
        Effect   = "Allow"
        Action   = ["s3:GetObject"]
        Resource = "${aws_s3_bucket.{{.Target}}.arn}/*"
      },
    ]
  })
}
{{- end}}
{{- range .TableReads}}

# The function or VM reads the table: no write action.
resource "aws_iam_role_policy" "{{.Addr}}" {
  name = "{{.Name}}"
  role = {{.Role}}.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Action = [
        "dynamodb:BatchGetItem",
        "dynamodb:ConditionCheckItem",
        "dynamodb:DescribeTable",
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:Scan",
      ]
      Resource = [
        aws_dynamodb_table.{{.Target}}.arn,
        "${aws_dynamodb_table.{{.Target}}.arn}/index/*",
      ]
    }]
  })
}
{{- end}}
{{- range .Routes}}

# The HTTP API sends every method on /{{.PathPart}} to the function.
resource "aws_api_gateway_resource" "{{.Addr}}" {
  rest_api_id = aws_api_gateway_rest_api.{{.API}}.id
  parent_id   = aws_api_gateway_rest_api.{{.API}}.root_resource_id
  path_part   = "{{.PathPart}}"
}

resource "aws_api_gateway_method" "{{.Addr}}" {
  rest_api_id   = aws_api_gateway_rest_api.{{.API}}.id
  resource_id   = aws_api_gateway_resource.{{.Addr}}.id
  http_method   = "ANY"
  authorization = "NONE"
}

resource "aws_api_gateway_integration" "{{.Addr}}" {
  rest_api_id             = aws_api_gateway_rest_api.{{.API}}.id
  resource_id             = aws_api_gateway_resource.{{.Addr}}.id
  http_method             = aws_api_gateway_method.{{.Addr}}.http_method
  type                    = "AWS_PROXY"
  integration_http_method = "POST"
  uri                     = aws_lambda_function.{{.Function}}.invoke_arn
}

resource "aws_lambda_permission" "{{.Addr}}" {
  statement_id  = "{{.StatementID}}"
  action        = "lambda:InvokeFunction"
  function_name = aws_lambda_function.{{.Function}}.function_name
  principal     = "apigateway.amazonaws.com"
  source_arn    = "${aws_api_gateway_rest_api.{{.API}}.execution_arn}/*/*"
}
{{- end}}
