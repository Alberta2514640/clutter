#### main.tf
# Generated by Clutter. Do not edit.

data "openstack_networking_network_v2" "external" {
  name     = "public"
  external = true
}

data "openstack_images_image_v2" "image" {
  name_regex  = "^cirros"
  most_recent = true
}

resource "openstack_networking_network_v2" "b_n2" {
  name           = "c3f2a9c1e-net"
  admin_state_up = true
}

resource "openstack_networking_subnet_v2" "b_n2" {
  name       = "c3f2a9c1e-net"
  network_id = openstack_networking_network_v2.b_n2.id
  cidr       = "10.20.0.0/24"
  ip_version = 4
}

resource "openstack_networking_router_v2" "b_n2" {
  name                = "c3f2a9c1e-net"
  external_network_id = data.openstack_networking_network_v2.external.id
}

resource "openstack_networking_router_interface_v2" "b_n2" {
  router_id = openstack_networking_router_v2.b_n2.id
  subnet_id = openstack_networking_subnet_v2.b_n2.id
}

resource "openstack_networking_secgroup_v2" "b_n3" {
  name = "c3f2a9c1e-fw"
}

resource "openstack_networking_secgroup_rule_v2" "b_n3_icmp" {
  security_group_id = openstack_networking_secgroup_v2.b_n3.id
  direction         = "ingress"
  ethertype         = "IPv4"
  protocol          = "icmp"
  remote_ip_prefix  = "0.0.0.0/0"
}

resource "openstack_networking_secgroup_rule_v2" "b_n3_tcp_22_22" {
  security_group_id = openstack_networking_secgroup_v2.b_n3.id
  direction         = "ingress"
  ethertype         = "IPv4"
  protocol          = "tcp"
  port_range_min    = 22
  port_range_max    = 22
  remote_ip_prefix  = "0.0.0.0/0"
}

resource "openstack_networking_secgroup_rule_v2" "b_n3_tcp_80_80" {
  security_group_id = openstack_networking_secgroup_v2.b_n3.id
  direction         = "ingress"
  ethertype         = "IPv4"
  protocol          = "tcp"
  port_range_min    = 80
  port_range_max    = 80
  remote_ip_prefix  = "0.0.0.0/0"
}

resource "openstack_networking_secgroup_rule_v2" "b_n3_udp_1000_2000" {
  security_group_id = openstack_networking_secgroup_v2.b_n3.id
  direction         = "ingress"
  ethertype         = "IPv4"
  protocol          = "udp"
  port_range_min    = 1000
  port_range_max    = 2000
  remote_ip_prefix  = "0.0.0.0/0"
}

resource "openstack_compute_instance_v2" "b_n1" {
  name            = "c3f2a9c1e-web"
  image_id        = data.openstack_images_image_v2.image.id
  flavor_name     = "m1.tiny"
  security_groups = [openstack_networking_secgroup_v2.b_n3.name]

  network {
    uuid = openstack_networking_network_v2.b_n2.id
  }

  depends_on = [openstack_networking_subnet_v2.b_n2]
}

resource "openstack_networking_floatingip_v2" "b_n1" {
  pool        = data.openstack_networking_network_v2.external.name
  description = "c3f2a9c1e-web"
}

data "openstack_networking_port_v2" "b_n1" {
  device_id  = openstack_compute_instance_v2.b_n1.id
  network_id = openstack_compute_instance_v2.b_n1.network[0].uuid
}

resource "openstack_networking_floatingip_associate_v2" "b_n1" {
  floating_ip = openstack_networking_floatingip_v2.b_n1.address
  port_id     = data.openstack_networking_port_v2.b_n1.id
  depends_on  = [openstack_networking_router_interface_v2.b_n2]
}

resource "openstack_blockstorage_volume_v3" "b_n4" {
  name = "c3f2a9c1e-data"
  size = 1
}

resource "openstack_compute_volume_attach_v2" "b_n4" {
  instance_id = openstack_compute_instance_v2.b_n1.id
  volume_id   = openstack_blockstorage_volume_v3.b_n4.id
}

#### outputs.tf
# Generated by Clutter. Do not edit.

output "id_n2" {
  value = openstack_networking_network_v2.b_n2.id
}

output "id_n3" {
  value = openstack_networking_secgroup_v2.b_n3.id
}

output "id_n1" {
  value = openstack_compute_instance_v2.b_n1.id
}

output "address_n1" {
  value = openstack_networking_floatingip_v2.b_n1.address
}

output "id_n4" {
  value = openstack_blockstorage_volume_v3.b_n4.id
}

#### versions.tf
# Generated by Clutter. Do not edit.
terraform {
  required_providers {
    openstack = {
      source  = "terraform-provider-openstack/openstack"
      version = "~> 3.4"
    }
  }
}

provider "openstack" {}

