# resources
# REST API
resource "aws_api_gateway_rest_api" "orders_api" {
  name        = "orders-api"
  description = "Orders API"

  endpoint_configuration {
    types = ["REGIONAL"]
  }
}

# CORS - OPTIONS preflight
resource "aws_api_gateway_method" "orders_api_options" {
  rest_api_id   = aws_api_gateway_rest_api.orders_api.id
  resource_id   = aws_api_gateway_rest_api.orders_api.root_resource_id
  http_method   = "OPTIONS"
  authorization = "NONE"
}

resource "aws_api_gateway_integration" "orders_api_options_integration" {
  rest_api_id = aws_api_gateway_rest_api.orders_api.id
  resource_id = aws_api_gateway_rest_api.orders_api.root_resource_id
  http_method = aws_api_gateway_method.orders_api_options.http_method
  type        = "MOCK"

  request_templates = {
    "application/json" = "{\"statusCode\": 200}"
  }
}

resource "aws_api_gateway_method_response" "orders_api_options_response" {
  rest_api_id = aws_api_gateway_rest_api.orders_api.id
  resource_id = aws_api_gateway_rest_api.orders_api.root_resource_id
  http_method = aws_api_gateway_method.orders_api_options.http_method
  status_code = "200"

  response_models = {
    "application/json" = "Empty"
  }

  response_parameters = {
    "method.response.header.Access-Control-Allow-Headers" = true
    "method.response.header.Access-Control-Allow-Methods" = true
    "method.response.header.Access-Control-Allow-Origin"  = true
  }
}

resource "aws_api_gateway_integration_response" "orders_api_options_integration_response" {
  rest_api_id = aws_api_gateway_rest_api.orders_api.id
  resource_id = aws_api_gateway_rest_api.orders_api.root_resource_id
  http_method = aws_api_gateway_method.orders_api_options.http_method
  status_code = aws_api_gateway_method_response.orders_api_options_response.status_code

  # The integration must exist first, or AWS answers "Invalid Response status code specified".
  depends_on = [aws_api_gateway_integration.orders_api_options_integration]

  response_parameters = {
    "method.response.header.Access-Control-Allow-Headers" = "'Content-Type,X-Amz-Date,Authorization,X-Api-Key,X-Amz-Security-Token'"
    "method.response.header.Access-Control-Allow-Methods" = "'GET,POST,DELETE,OPTIONS'"
    "method.response.header.Access-Control-Allow-Origin"  = "'*'"
  }
}

# Deployment. AWS refuses to deploy an API with no method, so there is none without one.
resource "aws_api_gateway_deployment" "orders_api_deployment" {
  count       = 1
  rest_api_id = aws_api_gateway_rest_api.orders_api.id

  triggers = {
    redeployment = sha1(jsonencode(aws_api_gateway_rest_api.orders_api.body))
  }

  depends_on = [
    aws_api_gateway_method.orders_api_options,
    aws_api_gateway_integration.orders_api_options_integration,
  ]

  lifecycle {
    create_before_destroy = true
  }
}

# Stage
resource "aws_api_gateway_stage" "orders_api_stage" {
  count         = 1
  rest_api_id   = aws_api_gateway_rest_api.orders_api.id
  deployment_id = aws_api_gateway_deployment.orders_api_deployment[0].id
  stage_name    = "v1"
}

# IAM Role
resource "aws_iam_role" "orders_handler_role" {
  name = "orders-handler-lambda-role"
  # The customer role may create, change or pass a role only under /clutter/,
  # with this boundary and tagged ManagedBy = Clutter.
  path                 = "/clutter/"
  permissions_boundary = var.permissions_boundary_arn
  assume_role_policy = jsonencode({
    "Version" : "2012-10-17",
    "Statement" : [{
      "Action" : "sts:AssumeRole",
      "Effect" : "Allow",
      "Sid" : "",
      "Principal" : {
        "Service" : "lambda.amazonaws.com"
      }
    }]
  })

  tags = {
    ManagedBy = "Clutter"
  }
}

# Lambda Function
resource "aws_lambda_function" "orders_handler" {
  function_name = "orders-handler"
  role          = aws_iam_role.orders_handler_role.arn
  handler       = "index.handler"
  timeout       = 30
  runtime       = "nodejs22.x"
  architectures = ["arm64"]
  memory_size      = 256
  filename         = "code/orders-handler/bootstrap.zip"
  source_code_hash = fileexists("code/orders-handler/bootstrap.zip") ? filebase64sha256("code/orders-handler/bootstrap.zip") : null
  environment {
    variables = {
      LOG_LEVEL = "info"
      TABLE_NAME = "orders"
    }
  }
}

resource "aws_dynamodb_table" "orders" {
  name         = "orders"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "orderId"

  attribute {
    name = "orderId"
    type = "S"
  }

  ttl {
    attribute_name = "expires_at"
    enabled        = true
  }
}

resource "random_id" "order_files_suffix" {
  byte_length = 4
}

# S3 Bucket
resource "aws_s3_bucket" "order_files" {
  bucket = "order-files-${random_id.order_files_suffix.hex}"
}
# Versioning
resource "aws_s3_bucket_versioning" "order_files_versioning" {
  bucket = aws_s3_bucket.order_files.id
  versioning_configuration {
    status = "Enabled"
  }
}
# Block Public Access
resource "aws_s3_bucket_public_access_block" "order_files_public_access" {
  bucket = aws_s3_bucket.order_files.id

  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

data "aws_ssm_parameter" "worker_ami" {
  name = "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
}

resource "aws_iam_role" "worker_ssm_role" {
  name = "worker-ssm-role"
  # The customer role may create, change or pass a role only under /clutter/,
  # with this boundary and tagged ManagedBy = Clutter. The instance below keeps
  # ManagedBy = Ansible, which is what lets the Ansible runner reach it.
  path                 = "/clutter/"
  permissions_boundary = var.permissions_boundary_arn

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "ec2.amazonaws.com" }
      Action    = "sts:AssumeRole"
    }]
  })

  tags = {
    ManagedBy = "Clutter"
  }
}

resource "aws_iam_role_policy_attachment" "worker_ssm_policy" {
  role       = aws_iam_role.worker_ssm_role.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
}

resource "aws_iam_instance_profile" "worker_ssm_profile" {
  name = "worker-ssm-profile"
  path = "/clutter/"
  role = aws_iam_role.worker_ssm_role.name
}

resource "aws_instance" "worker" {
  ami                  = data.aws_ssm_parameter.worker_ami.value
  instance_type        = "t3.micro"
  iam_instance_profile = aws_iam_instance_profile.worker_ssm_profile.name
  key_name = "ops-key"

  tags = {
    Name      = "worker"
    ManagedBy = "Ansible"
  }
}

# iam
resource "aws_lambda_permission" "orders_api_invoke_orders_handler" {
  statement_id  = "AllowExecutionFromAPIGateway"
  action        = "lambda:InvokeFunction"
  function_name = aws_lambda_function.orders_handler.function_name
  principal     = "apigateway.amazonaws.com"
  source_arn    = "${aws_api_gateway_rest_api.orders_api.execution_arn}/*/*"
}

resource "aws_iam_role_policy" "orders_handler_to_orders" {
  name = "orders_handler_to_orders-access"
  role = aws_iam_role.orders_handler_role.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect = "Allow"
        Action = [
          "dynamodb:BatchGetItem",
          "dynamodb:ConditionCheckItem",
          "dynamodb:DescribeTable",
          "dynamodb:GetItem",
          "dynamodb:Query",
          "dynamodb:Scan",
        ]
        Resource = [
          aws_dynamodb_table.orders.arn,
          "${aws_dynamodb_table.orders.arn}/index/*",
        ]
      },
    ]
  })
}

resource "aws_iam_role_policy" "orders_handler_to_order_files" {
  name = "orders_handler_to_order_files-access"
  role = aws_iam_role.orders_handler_role.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect   = "Allow"
        Action   = ["s3:ListBucket"]
        Resource = aws_s3_bucket.order_files.arn
      },
      {
        Effect   = "Allow"
        Action   = ["s3:GetObject"]
        Resource = "${aws_s3_bucket.order_files.arn}/*"
      },
    ]
  })
}


# outputs
output "orders_api_id" {
  value = aws_api_gateway_rest_api.orders_api.id
}

output "orders_api_root_resource_id" {
  value = aws_api_gateway_rest_api.orders_api.root_resource_id
}

output "orders_api_execution_arn" {
  value = aws_api_gateway_rest_api.orders_api.execution_arn
}

output "orders_api_invoke_url" {
  # Null when the API has no method, and so no stage.
  value = one(aws_api_gateway_stage.orders_api_stage[*].invoke_url)
}

output "orders_handler_function_name" {
  value = aws_lambda_function.orders_handler.function_name
}

output "orders_handler_arn" {
  value = aws_lambda_function.orders_handler.arn
}

output "orders_handler_invoke_arn" {
  value = aws_lambda_function.orders_handler.invoke_arn
}

output "orders_arn" {
  value = aws_dynamodb_table.orders.arn
}

output "orders_name" {
  value = aws_dynamodb_table.orders.name
}

output "order_files_bucket_name" {
  value = aws_s3_bucket.order_files.bucket
}

output "order_files_bucket_arn" {
  value = aws_s3_bucket.order_files.arn
}

output "order_files_bucket_domain_name" {
  value = aws_s3_bucket.order_files.bucket_domain_name
}

output "worker_id" {
  value = aws_instance.worker.id
}

output "worker_public_ip" {
  value = aws_instance.worker.public_ip
}
