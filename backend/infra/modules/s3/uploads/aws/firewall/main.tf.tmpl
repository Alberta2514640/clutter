# Security group
resource "aws_security_group" "{{.ResourceName}}" {
  name        = "{{.GroupName}}"
  description = "Managed by Clutter"
{{- if .VPCResourceName}}
  vpc_id      = aws_vpc.{{.VPCResourceName}}.id
{{- end}}

  tags = {
    Name = "{{.GroupName}}"
  }
}
{{- range $i, $r := .Ingress}}

resource "aws_vpc_security_group_ingress_rule" "{{$.ResourceName}}_in_{{$i}}" {
  security_group_id = aws_security_group.{{$.ResourceName}}.id
  ip_protocol       = "{{$r.Protocol}}"
  from_port         = {{$r.FromPort}}
  to_port           = {{$r.ToPort}}
{{- if $r.IPv6}}
  cidr_ipv6         = "{{$r.CIDR}}"
{{- else}}
  cidr_ipv4         = "{{$r.CIDR}}"
{{- end}}
}
{{- end}}

# Terraform removes the default allow-all egress rule, so it is declared here.
resource "aws_vpc_security_group_egress_rule" "{{.ResourceName}}_out_all" {
  security_group_id = aws_security_group.{{.ResourceName}}.id
  ip_protocol       = "-1"
  cidr_ipv4         = "0.0.0.0/0"
}
