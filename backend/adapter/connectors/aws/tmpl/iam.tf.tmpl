# Wiring from the diagram's edges. Every role and resource named here is
# rendered by A's lambda, ec2, s3, dynamodb and apigateway templates, or by
# defaults.tf.
{{- range .Functions}}

# Every function may write its own logs, to its own log group and nothing
# else. The group exists first (defaults.tf), so the function needs no right
# to create one.
resource "aws_iam_role_policy" "{{.}}_logs" {
  name = "{{.}}-logs"
  role = aws_iam_role.{{.}}_role.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = ["logs:CreateLogStream", "logs:PutLogEvents"]
      Resource = "${aws_cloudwatch_log_group.{{.}}.arn}:*"
    }]
  })
}
{{- end}}
{{- range .BucketReads}}

# The function or VM reads the bucket: list it and get objects, nothing more.
resource "aws_iam_role_policy" "{{.Addr}}" {
  name = "{{.Name}}"
  role = {{.Role}}.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect   = "Allow"
        Action   = ["s3:ListBucket"]
        Resource = aws_s3_bucket.{{.Target}}.arn
      },
      {
        Effect   = "Allow"
        Action   = ["s3:GetObject"]
        Resource = "${aws_s3_bucket.{{.Target}}.arn}/*"
      },
    ]
  })
}
{{- end}}
{{- range .TableReads}}

# The function or VM reads the table: no write action.
resource "aws_iam_role_policy" "{{.Addr}}" {
  name = "{{.Name}}"
  role = {{.Role}}.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Action = [
        "dynamodb:BatchGetItem",
        "dynamodb:ConditionCheckItem",
        "dynamodb:DescribeTable",
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:Scan",
      ]
      Resource = [
        aws_dynamodb_table.{{.Target}}.arn,
        "${aws_dynamodb_table.{{.Target}}.arn}/index/*",
      ]
    }]
  })
}
{{- end}}
{{- range .Routes}}

# The HTTP API sends every method on /{{.PathPart}} to the function.
resource "aws_api_gateway_resource" "{{.Addr}}" {
  rest_api_id = aws_api_gateway_rest_api.{{.API}}.id
  parent_id   = aws_api_gateway_rest_api.{{.API}}.root_resource_id
  path_part   = "{{.PathPart}}"
}

resource "aws_api_gateway_method" "{{.Addr}}" {
  rest_api_id   = aws_api_gateway_rest_api.{{.API}}.id
  resource_id   = aws_api_gateway_resource.{{.Addr}}.id
  http_method   = "ANY"
  authorization = "NONE"
}

resource "aws_api_gateway_integration" "{{.Addr}}" {
  rest_api_id             = aws_api_gateway_rest_api.{{.API}}.id
  resource_id             = aws_api_gateway_resource.{{.Addr}}.id
  http_method             = aws_api_gateway_method.{{.Addr}}.http_method
  type                    = "AWS_PROXY"
  integration_http_method = "POST"
  uri                     = aws_lambda_function.{{.Function}}.invoke_arn
}

resource "aws_lambda_permission" "{{.Addr}}" {
  statement_id  = "{{.StatementID}}"
  action        = "lambda:InvokeFunction"
  function_name = aws_lambda_function.{{.Function}}.function_name
  principal     = "apigateway.amazonaws.com"
  source_arn    = "${aws_api_gateway_rest_api.{{.API}}.execution_arn}/*/*"
}
{{- if .CORS}}

# The API's CORS answer on /{{.PathPart}}: a browser's preflight OPTIONS
# request gets the allowed origin, methods and headers. The function's own
# responses carry their CORS headers, as with any proxy integration.
resource "aws_api_gateway_method" "{{.Addr}}_options" {
  rest_api_id   = aws_api_gateway_rest_api.{{.API}}.id
  resource_id   = aws_api_gateway_resource.{{.Addr}}.id
  http_method   = "OPTIONS"
  authorization = "NONE"
}

resource "aws_api_gateway_integration" "{{.Addr}}_options" {
  rest_api_id = aws_api_gateway_rest_api.{{.API}}.id
  resource_id = aws_api_gateway_resource.{{.Addr}}.id
  http_method = aws_api_gateway_method.{{.Addr}}_options.http_method
  type        = "MOCK"

  request_templates = {
    "application/json" = "{\"statusCode\": 200}"
  }
}

resource "aws_api_gateway_method_response" "{{.Addr}}_options" {
  rest_api_id = aws_api_gateway_rest_api.{{.API}}.id
  resource_id = aws_api_gateway_resource.{{.Addr}}.id
  http_method = aws_api_gateway_method.{{.Addr}}_options.http_method
  status_code = "200"

  response_models = {
    "application/json" = "Empty"
  }

  response_parameters = {
    "method.response.header.Access-Control-Allow-Headers" = true
    "method.response.header.Access-Control-Allow-Methods" = true
    "method.response.header.Access-Control-Allow-Origin"  = true
  }
}

resource "aws_api_gateway_integration_response" "{{.Addr}}_options" {
  rest_api_id = aws_api_gateway_rest_api.{{.API}}.id
  resource_id = aws_api_gateway_resource.{{.Addr}}.id
  http_method = aws_api_gateway_method.{{.Addr}}_options.http_method
  status_code = aws_api_gateway_method_response.{{.Addr}}_options.status_code

  # The integration must exist first, or AWS answers "Invalid Response status code specified".
  depends_on = [aws_api_gateway_integration.{{.Addr}}_options]

  response_parameters = {
    "method.response.header.Access-Control-Allow-Headers" = "'Content-Type,X-Amz-Date,Authorization,X-Api-Key,X-Amz-Security-Token'"
    "method.response.header.Access-Control-Allow-Methods" = "'DELETE,GET,HEAD,OPTIONS,PATCH,POST,PUT'"
    "method.response.header.Access-Control-Allow-Origin"  = "'*'"
  }
}
{{- end}}
{{- end}}
{{- range .Peers}}

# VMs that get {{.Target}}'s address may reach it: every protocol and port,
# from each one's private address only. A security group of its own, beside
# the VM's firewalls; it keeps the allow-all egress rule a VM with no firewall
# had from its network's default group.
resource "aws_security_group" "{{.Addr}}" {
  name        = "{{.Name}}"
  description = "Managed by Clutter"
{{- if .VPC}}
  vpc_id      = aws_vpc.{{.VPC}}.id
{{- end}}

  tags = {
    Name = "{{.Name}}"
  }
}
{{- $group := .Addr}}
{{- range .Sources}}

resource "aws_vpc_security_group_ingress_rule" "{{$group}}_from_{{.Part}}" {
  security_group_id = aws_security_group.{{$group}}.id
  ip_protocol       = "-1"
  cidr_ipv4         = "${aws_instance.{{.Addr}}.private_ip}/32"
}
{{- end}}

resource "aws_vpc_security_group_egress_rule" "{{.Addr}}_out_all" {
  security_group_id = aws_security_group.{{.Addr}}.id
  ip_protocol       = "-1"
  cidr_ipv4         = "0.0.0.0/0"
}
{{- end}}
